              "\n",
              "\n",
              "// =========================================================\n",
              "// ANALYZE CONIC\n",
              "// =========================================================\n",
              "\n",
              "function analyzeFrontend() {\n",
              "\n",
              "    const {\n",
              "        a, h, b, g, f, c\n",
              "    } = getFrontendInputs();\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Quadratic matrix\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    document.getElementById(\n",
              "        \"matrix-output\"\n",
              "    ).innerHTML =\n",
              "\n",
              "        `[ ${a.toFixed(4)} &nbsp; ${h.toFixed(4)} ]<br>` +\n",
              "        `[ ${h.toFixed(4)} &nbsp; ${b.toFixed(4)} ]`;\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Eigenvalues\n",
              "    //\n",
              "    // For:\n",
              "    //\n",
              "    // A = [a h]\n",
              "    //     [h b]\n",
              "    //\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    const trace = a + b;\n",
              "\n",
              "    const determinant =\n",
              "        a * b - h * h;\n",
              "\n",
              "    const delta =\n",
              "        Math.sqrt(\n",
              "            Math.max(\n",
              "                0,\n",
              "                (a - b) ** 2 +\n",
              "                4 * h ** 2\n",
              "            )\n",
              "        );\n",
              "\n",
              "\n",
              "    const lambda1 =\n",
              "        (trace + delta) / 2;\n",
              "\n",
              "    const lambda2 =\n",
              "        (trace - delta) / 2;\n",
              "\n",
              "\n",
              "    document.getElementById(\n",
              "        \"eigen-output\"\n",
              "    ).innerHTML =\n",
              "\n",
              "        `λ₁ = ${lambda1.toFixed(6)}<br>` +\n",
              "        `λ₂ = ${lambda2.toFixed(6)}`;\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Classification\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    const tolerance = 1e-9;\n",
              "\n",
              "    let classification = \"Unknown\";\n",
              "\n",
              "\n",
              "    if (\n",
              "        Math.abs(determinant) < tolerance\n",
              "    ) {\n",
              "\n",
              "        if (\n",
              "            Math.abs(a) < tolerance &&\n",
              "            Math.abs(h) < tolerance &&\n",
              "            Math.abs(b) < tolerance\n",
              "        ) {\n",
              "\n",
              "            classification = \"Linear / Degenerate\";\n",
              "\n",
              "        } else {\n",
              "\n",
              "            classification = \"Parabola\";\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (\n",
              "        Math.abs(a - b) < tolerance &&\n",
              "        Math.abs(h) < tolerance\n",
              "    ) {\n",
              "\n",
              "        const radiusSquared =\n",
              "            -c / a;\n",
              "\n",
              "\n",
              "        if (\n",
              "            radiusSquared > tolerance\n",
              "        ) {\n",
              "\n",
              "            classification = \"Circle\";\n",
              "\n",
              "        }\n",
              "\n",
              "        else if (\n",
              "            Math.abs(radiusSquared) < tolerance\n",
              "        ) {\n",
              "\n",
              "            classification = \"Point\";\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            classification = \"Empty\";\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (\n",
              "        determinant > tolerance\n",
              "    ) {\n",
              "\n",
              "        // Center exists for a non-singular A.\n",
              "        const centerX =\n",
              "            (h * f - b * g) /\n",
              "            determinant;\n",
              "\n",
              "        const centerY =\n",
              "            (h * g - a * f) /\n",
              "            determinant;\n",
              "\n",
              "\n",
              "        // Translated constant:\n",
              "        const F =\n",
              "            c\n",
              "            - (\n",
              "                b * g * g\n",
              "                - 2 * h * g * f\n",
              "                + a * f * f\n",
              "            ) / determinant;\n",
              "\n",
              "\n",
              "        if (\n",
              "            -F / lambda1 > tolerance &&\n",
              "            -F / lambda2 > tolerance\n",
              "        ) {\n",
              "\n",
              "            classification = \"Ellipse\";\n",
              "\n",
              "        }\n",
              "\n",
              "        else if (\n",
              "            Math.abs(F) < tolerance\n",
              "        ) {\n",
              "\n",
              "            classification = \"Point\";\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            classification = \"Empty\";\n",
              "\n",
              "        }\n",
              "\n",
              "\n",
              "        document.getElementById(\n",
              "            \"center\"\n",
              "        ).innerText =\n",
              "\n",
              "            `(${centerX.toFixed(4)}, ` +\n",
              "            `${centerY.toFixed(4)})`;\n",
              "\n",
              "    }\n",
              "\n",
              "    else {\n",
              "\n",
              "        classification = \"Hyperbola\";\n",
              "\n",
              "        if (\n",
              "            Math.abs(determinant) > tolerance\n",
              "        ) {\n",
              "\n",
              "            const centerX =\n",
              "                (h * f - b * g) /\n",
              "                determinant;\n",
              "\n",
              "            const centerY =\n",
              "                (h * g - a * f) /\n",
              "                determinant;\n",
              "\n",
              "            document.getElementById(\n",
              "                \"center\"\n",
              "            ).innerText =\n",
              "\n",
              "                `(${centerX.toFixed(4)}, ` +\n",
              "                `${centerY.toFixed(4)})`;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Rotation angle\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    let angle = 0;\n",
              "\n",
              "\n",
              "    if (\n",
              "        Math.abs(a - b) > tolerance ||\n",
              "        Math.abs(h) > tolerance\n",
              "    ) {\n",
              "\n",
              "        angle =\n",
              "            0.5 *\n",
              "            Math.atan2(\n",
              "                2 * h,\n",
              "                a - b\n",
              "            ) *\n",
              "            180 /\n",
              "            Math.PI;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    document.getElementById(\n",
              "        \"rotation\"\n",
