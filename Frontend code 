      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# CELL 21: PROFESSIONAL CSS\n",
        "# ============================================================\n",
        "\n",
        "display(HTML(r\"\"\"\n",
        "\n",
        "<style>\n",
        "\n",
        "* {\n",
        "    box-sizing: border-box;\n",
        "}\n",
        "\n",
        ".conic-app {\n",
        "\n",
        "    margin: -10px -10px 0 -10px;\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            135deg,\n",
        "            #eef5ff,\n",
        "            #f8fbff 50%,\n",
        "            #edf4ff\n",
        "        );\n",
        "\n",
        "    min-height: 100vh;\n",
        "\n",
        "    color: #172033;\n",
        "\n",
        "    font-family:\n",
        "        Arial,\n",
        "        Helvetica,\n",
        "        sans-serif;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   HEADER\n",
        "========================================================= */\n",
        "\n",
        ".app-header {\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            135deg,\n",
        "            #061b49,\n",
        "            #0b3d91,\n",
        "            #1769aa\n",
        "        );\n",
        "\n",
        "    color: white;\n",
        "\n",
        "    padding:\n",
        "        22px 7%;\n",
        "\n",
        "    display: flex;\n",
        "\n",
        "    justify-content:\n",
        "        space-between;\n",
        "\n",
        "    align-items:\n",
        "        center;\n",
        "\n",
        "    box-shadow:\n",
        "        0 5px 25px\n",
        "        rgba(0,0,0,.18);\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".brand {\n",
        "\n",
        "    display: flex;\n",
        "\n",
        "    align-items: center;\n",
        "\n",
        "    gap: 15px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".infinity-logo {\n",
        "\n",
        "    font-size: 50px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    line-height: 1;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".brand h1 {\n",
        "\n",
        "    margin: 0;\n",
        "\n",
        "    font-size: 24px;\n",
        "\n",
        "    letter-spacing: 2px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".brand p {\n",
        "\n",
        "    margin: 4px 0 0;\n",
        "\n",
        "    font-size: 11px;\n",
        "\n",
        "    opacity: .75;\n",
        "\n",
        "    letter-spacing: 1px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".project-badge {\n",
        "\n",
        "    padding:\n",
        "        10px 17px;\n",
        "\n",
        "    border:\n",
        "        1px solid\n",
        "        rgba(255,255,255,.4);\n",
        "\n",
        "    border-radius: 30px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   HERO\n",
        "========================================================= */\n",
        "\n",
        ".hero {\n",
        "\n",
        "    padding:\n",
        "        65px 20px 45px;\n",
        "\n",
        "    text-align: center;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".hero-content {\n",
        "\n",
        "    max-width: 850px;\n",
        "\n",
        "    margin: auto;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".tag {\n",
        "\n",
        "    color: #1769aa;\n",
        "\n",
        "    font-size: 12px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    letter-spacing: 2px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".hero h2 {\n",
        "\n",
        "    margin:\n",
        "        12px 0;\n",
        "\n",
        "    font-size:\n",
        "        clamp(32px, 5vw, 52px);\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            90deg,\n",
        "            #082d70,\n",
        "            #1769aa\n",
        "        );\n",
        "\n",
        "    -webkit-background-clip:\n",
        "        text;\n",
        "\n",
        "    -webkit-text-fill-color:\n",
        "        transparent;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".hero p:not(.tag) {\n",
        "\n",
        "    color: #667085;\n",
        "\n",
        "    line-height: 1.7;\n",
        "\n",
        "    max-width: 680px;\n",
        "\n",
        "    margin: auto;\n",
        "\n",
        "    font-size: 16px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   MAIN\n",
        "========================================================= */\n",
        "\n",
        ".main-container {\n",
        "\n",
        "    width: 90%;\n",
        "\n",
        "    max-width: 1150px;\n",
        "\n",
        "    margin: auto;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   CARD\n",
        "========================================================= */\n",
        "\n",
        ".glass-card {\n",
        "\n",
        "    background:\n",
        "        rgba(255,255,255,.92);\n",
        "\n",
        "    border:\n",
        "        1px solid\n",
        "        rgba(30,80,140,.08);\n",
        "\n",
        "    border-radius: 20px;\n",
        "\n",
        "    padding: 28px;\n",
        "\n",
        "    margin-bottom: 24px;\n",
        "\n",
        "    box-shadow:\n",
        "        0 12px 35px\n",
        "        rgba(15,55,100,.08);\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".section-heading {\n",
        "\n",
        "    display: flex;\n",
        "\n",
        "    align-items: center;\n",
        "\n",
        "    gap: 12px;\n",
        "\n",
        "    margin-bottom: 22px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".section-heading span {\n",
        "\n",
        "    color: #1769aa;\n",
        "\n",
        "    font-size: 12px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".section-heading h3 {\n",
        "\n",
        "    margin: 0;\n",
        "\n",
        "    color: #102a56;\n",
        "\n",
        "    font-size: 20px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   EQUATION\n",
        "========================================================= */\n",
        "\n",
        ".equation-display {\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            135deg,\n",
        "            #edf5ff,\n",
        "            #f7fbff\n",
        "        );\n",
        "\n",
        "    border-radius: 14px;\n",
        "\n",
        "    padding: 20px;\n",
        "\n",
        "    text-align: center;\n",
        "\n",
        "    font-size: 21px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    color: #0b3d91;\n",
        "\n",
        "    margin-bottom: 25px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   INPUTS\n",
        "========================================================= */\n",
        "\n",
        ".input-grid {\n",
        "\n",
        "    display: grid;\n",
        "\n",
        "    grid-template-columns:\n",
        "        repeat(6, 1fr);\n",
        "\n",
        "    gap: 14px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".input-box label {\n",
        "\n",
        "    display: block;\n",
        "\n",
        "    margin-bottom: 7px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    color: #475467;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".input-box input {\n",
        "\n",
        "    width: 100%;\n",
        "\n",
        "    padding: 13px;\n",
        "\n",
        "    border:\n",
        "        1px solid #d8e0ea;\n",
        "\n",
        "    border-radius: 10px;\n",
        "\n",
        "    outline: none;\n",
        "\n",
        "    font-size: 15px;\n",
        "\n",
        "    transition: .2s;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".input-box input:focus {\n",
        "\n",
        "    border-color:\n",
        "        #1769aa;\n",
        "\n",
        "    box-shadow:\n",
        "        0 0 0 3px\n",
        "        rgba(23,105,170,.12);\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   BUTTONS\n",
        "========================================================= */\n",
        "\n",
        ".button-row {\n",
        "\n",
        "    display: flex;\n",
        "\n",
        "    flex-wrap: wrap;\n",
        "\n",
        "    gap: 10px;\n",
        "\n",
        "    margin-top: 22px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".button-row button {\n",
        "\n",
        "    border: none;\n",
        "\n",
        "    border-radius: 10px;\n",
        "\n",
        "    padding:\n",
        "        12px 18px;\n",
        "\n",
        "    cursor: pointer;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    transition:\n",
        "        transform .15s,\n",
        "        box-shadow .15s;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".button-row button:hover {\n",
        "\n",
        "    transform:\n",
        "        translateY(-2px);\n",
        "\n",
        "    box-shadow:\n",
        "        0 5px 15px\n",
        "        rgba(0,0,0,.1);\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".primary-btn {\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            135deg,\n",
        "            #0b3d91,\n",
        "            #1769aa\n",
        "        );\n",
        "\n",
        "    color: white;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".secondary-btn {\n",
        "\n",
        "    background: #edf4fc;\n",
        "\n",
        "    color: #0b3d91;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".reset-btn {\n",
        "\n",
        "    background: #f1f3f5;\n",
        "\n",
        "    color: #475467;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   RESULT GRID\n",
        "========================================================= */\n",
        "\n",
        ".result-grid {\n",
        "\n",
        "    display: grid;\n",
        "\n",
        "    grid-template-columns:\n",
        "        repeat(3, 1fr);\n",
        "\n",
        "    gap: 18px;\n",
        "\n",
        "    margin-bottom: 24px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".result-card {\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            145deg,\n",
        "            #ffffff,\n",
        "            #f3f8ff\n",
        "        );\n",
        "\n",
        "    padding: 25px;\n",
        "\n",
        "    border-radius: 18px;\n",
        "\n",
        "    box-shadow:\n",
        "        0 10px 30px\n",
        "        rgba(20,60,110,.08);\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".result-icon {\n",
        "\n",
        "    font-size: 25px;\n",
        "\n",
        "    color: #1769aa;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".result-card p {\n",
        "\n",
        "    margin:\n",
        "        12px 0 7px;\n",
        "\n",
        "    color: #667085;\n",
        "\n",
        "    font-size: 11px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    letter-spacing: 1px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".result-card h2 {\n",
        "\n",
        "    margin: 0;\n",
        "\n",
        "    color: #0b3d91;\n",
        "\n",
        "    font-size: 24px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   TWO COLUMNS\n",
        "========================================================= */\n",
        "\n",
        ".two-column {\n",
        "\n",
        "    display: grid;\n",
        "\n",
        "    grid-template-columns:\n",
        "        1fr 1fr;\n",
        "\n",
        "    gap: 24px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   MATRIX\n",
        "========================================================= */\n",
        "\n",
        ".matrix-output {\n",
        "\n",
        "    background: #f5f8fc;\n",
        "\n",
        "    border-radius: 12px;\n",
        "\n",
        "    padding: 20px;\n",
        "\n",
        "    font-family: monospace;\n",
        "\n",
        "    font-size: 18px;\n",
        "\n",
        "    line-height: 2;\n",
        "\n",
        "    text-align: center;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".eigen-output {\n",
        "\n",
        "    background: #f5f8fc;\n",
        "\n",
        "    border-radius: 12px;\n",
        "\n",
        "    padding: 20px;\n",
        "\n",
        "    font-family: monospace;\n",
        "\n",
        "    font-size: 18px;\n",
        "\n",
        "    line-height: 2;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".canonical-output {\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            135deg,\n",
        "            #eef6ff,\n",
        "            #f7fbff\n",
        "        );\n",
        "\n",
        "    border-radius: 14px;\n",
        "\n",
        "    padding: 22px;\n",
        "\n",
        "    text-align: center;\n",
        "\n",
        "    color: #0b3d91;\n",
        "\n",
        "    font-size: 20px;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   GRAPH\n",
        "========================================================= */\n",
        "\n",
        ".graph-card {\n",
        "\n",
        "    overflow: hidden;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".graph-container {\n",
        "\n",
        "    width: 100%;\n",
        "\n",
        "    height: 500px;\n",
        "\n",
        "    background:\n",
        "        #f8fbff;\n",
        "\n",
        "    border-radius: 15px;\n",
        "\n",
        "    overflow: hidden;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "#conicCanvas {\n",
        "\n",
        "    width: 100%;\n",
        "\n",
        "    height: 100%;\n",
        "\n",
        "    display: block;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   PROCESS\n",
        "========================================================= */\n",
        "\n",
        ".process-grid {\n",
        "\n",
        "    display: grid;\n",
        "\n",
        "    grid-template-columns:\n",
        "        repeat(3, 1fr);\n",
        "\n",
        "    gap: 15px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".process-card {\n",
        "\n",
        "    padding: 20px;\n",
        "\n",
        "    background:\n",
        "        #f7faff;\n",
        "\n",
        "    border-radius: 14px;\n",
        "\n",
        "    border-left:\n",
        "        4px solid #1769aa;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".process-card span {\n",
        "\n",
        "    color: #1769aa;\n",
        "\n",
        "    font-weight: bold;\n",
        "\n",
        "    font-size: 12px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".process-card h4 {\n",
        "\n",
        "    margin:\n",
        "        8px 0;\n",
        "\n",
        "    color: #172033;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        ".process-card p {\n",
        "\n",
        "    margin: 0;\n",
        "\n",
        "    color: #667085;\n",
        "\n",
        "    font-size: 13px;\n",
        "\n",
        "    line-height: 1.5;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "/* =========================================================\n",
        "   FOOTER\n",
        "========================================================= */\n",
        "\n",
        "footer {\n",
        "\n",
        "    margin-top: 50px;\n",
        "\n",
        "    padding: 30px;\n",
        "\n",
        "    background:\n",
        "        linear-gradient(\n",
        "            135deg,\n",
        "            #061b49,\n",
        "            #0b3d91\n",
        "        );\n",
        "\n",
        "    color: white;\n",
        "\n",
        "    text-align: center;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "footer strong {\n",
        "\n",
        "    font-size: 20px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "footer p {\n",
        "\n",
        "    margin:\n",
        "        8px 0;\n",
        "\n",
        "    opacity: .85;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
