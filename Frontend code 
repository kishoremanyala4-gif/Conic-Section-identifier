              "\n",
              "}\n",
              "\n",
              "\n",
              "// =========================================================\n",
              "// CANONICAL FORM\n",
              "// =========================================================\n",
              "\n",
              "function generateCanonicalForm(\n",
              "    classification,\n",
              "    lambda1,\n",
              "    lambda2,\n",
              "    a,\n",
              "    b,\n",
              "    h,\n",
              "    g,\n",
              "    f,\n",
              "    c\n",
              ") {\n",
              "\n",
              "    let text = \"\";\n",
              "\n",
              "\n",
              "    if (\n",
              "        classification === \"Circle\"\n",
              "    ) {\n",
              "\n",
              "        const r2 = -c / a;\n",
              "\n",
              "        text =\n",
              "            `u² + v² = ${r2.toFixed(4)}`;\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (\n",
              "        classification === \"Ellipse\"\n",
              "    ) {\n",
              "\n",
              "        const det =\n",
              "            a * b - h * h;\n",
              "\n",
              "        const F =\n",
              "            c -\n",
              "            (\n",
              "                b * g * g\n",
              "                - 2 * h * g * f\n",
              "                + a * f * f\n",
              "            ) / det;\n",
              "\n",
              "\n",
              "        const A1 =\n",
              "            -F / lambda1;\n",
              "\n",
              "        const A2 =\n",
              "            -F / lambda2;\n",
              "\n",
              "\n",
              "        if (\n",
              "            A1 > 0 &&\n",
              "            A2 > 0\n",
              "        ) {\n",
              "\n",
              "            text =\n",
              "                `u²/${A1.toFixed(4)} + ` +\n",
              "                `v²/${A2.toFixed(4)} = 1`;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (\n",
              "        classification === \"Hyperbola\"\n",
              "    ) {\n",
              "\n",
              "        text =\n",
              "            `λ₁u² + λ₂v² = constant`;\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (\n",
              "        classification === \"Parabola\"\n",
              "    ) {\n",
              "\n",
              "        text =\n",
              "            `Canonical form: U² = 4pV`;\n",
              "\n",
              "    }\n",
              "\n",
              "    else {\n",
              "\n",
              "        text =\n",
              "            \"Canonical form determined by the mathematical model.\";\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    document.getElementById(\n",
              "        \"canonical-output\"\n",
              "    ).innerText = text;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// =========================================================\n",
              "// PROFESSIONAL CONIC GRAPH\n",
              "// =========================================================\n",
              "\n",
              "function drawProfessionalConic(\n",
              "    a,\n",
              "    h,\n",
              "    b,\n",
              "    g,\n",
              "    f,\n",
              "    c,\n",
              "    classification\n",
              ") {\n",
              "\n",
              "    const canvas =\n",
              "        document.getElementById(\n",
              "            \"conicCanvas\"\n",
              "        );\n",
              "\n",
              "\n",
              "    const ctx =\n",
              "        canvas.getContext(\"2d\");\n",
              "\n",
              "\n",
              "    const rect =\n",
              "        canvas.getBoundingClientRect();\n",
              "\n",
              "\n",
              "    const width =\n",
              "        rect.width;\n",
              "\n",
              "    const height =\n",
              "        rect.height;\n",
              "\n",
              "\n",
              "    const dpr =\n",
              "        window.devicePixelRatio || 1;\n",
              "\n",
              "\n",
              "    canvas.width =\n",
              "        width * dpr;\n",
              "\n",
              "    canvas.height =\n",
              "        height * dpr;\n",
              "\n",
              "\n",
              "    ctx.setTransform(\n",
              "        dpr,\n",
              "        0,\n",
              "        0,\n",
              "        dpr,\n",
              "        0,\n",
              "        0\n",
              "    );\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Background\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"#f8fbff\";\n",
              "\n",
              "    ctx.fillRect(\n",
              "        0,\n",
              "        0,\n",
              "        width,\n",
              "        height\n",
              "    );\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Coordinate system\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    const scale = 45;\n",
              "\n",
              "    const originX =\n",
              "        width / 2;\n",
              "\n",
              "    const originY =\n",
              "        height / 2;\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Grid\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    ctx.strokeStyle =\n",
              "        \"#dfe7f2\";\n",
              "\n",
              "    ctx.lineWidth = 1;\n",
              "\n",
              "\n",
              "    for (\n",
              "        let x = originX % scale;\n",
              "        x < width;\n",
              "        x += scale\n",
              "    ) {\n",
              "\n",
              "        ctx.beginPath();\n",
              "\n",
              "        ctx.moveTo(x, 0);\n",
              "\n",
              "        ctx.lineTo(\n",
              "            x,\n",
              "            height\n",
              "        );\n",
              "\n",
              "        ctx.stroke();\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    for (\n",
              "        let y = originY % scale;\n",
              "        y < height;\n",
              "        y += scale\n",
              "    ) {\n",
              "\n",
              "        ctx.beginPath();\n",
              "\n",
              "        ctx.moveTo(0, y);\n",
              "\n",
              "        ctx.lineTo(\n",
              "            width,\n",
              "            y\n",
              "        );\n",
              "\n",
              "        ctx.stroke();\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Axes\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    ctx.strokeStyle =\n",
              "        \"#26364d\";\n",
              "\n",
              "    ctx.lineWidth = 1.5;\n",
              "\n",
              "\n",
              "    ctx.beginPath();\n",
              "\n",
              "    ctx.moveTo(\n",
              "        0,\n",
              "        originY\n",
              "    );\n",
              "\n",
              "    ctx.lineTo(\n",
              "        width,\n",
              "        originY\n",
              "    );\n",
              "\n",
              "    ctx.stroke();\n",
              "\n",
              "\n",
              "    ctx.beginPath();\n",
              "\n",
              "    ctx.moveTo(\n",
              "        originX,\n",
              "        0\n",
              "    );\n",
              "\n",
              "    ctx.lineTo(\n",
              "        originX,\n",
              "        height\n",
              "    );\n",
              "\n",
              "    ctx.stroke();\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Function\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    function equation(x, y) {\n",
              "\n",
              "        return (\n",
              "            a * x * x\n",
              "            + 2 * h * x * y\n",
              "            + b * y * y\n",
              "            + 2 * g * x\n",
              "            + 2 * f * y\n",
              "            + c\n",
              "        );\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Plot implicit curve\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"#1769aa\";\n",
              "\n",
              "\n",
              "    const step = 2;\n",
              "\n",
              "\n",
              "    for (\n",
              "        let px = 0;\n",
              "        px < width;\n",
              "        px += step\n",
              "    ) {\n",
              "\n",
              "        for (\n",
              "            let py = 0;\n",
              "            py < height;\n",
              "            py += step\n",
              "        ) {\n",
              "\n",
              "            const x =\n",
              "                (px - originX) /\n",
              "                scale;\n",
              "\n",
              "            const y =\n",
              "                (originY - py) /\n",
              "                scale;\n",
              "\n",
              "\n",
              "            const value =\n",
              "                equation(x, y);\n",
              "\n",
              "\n",
              "            const xNext =\n",
              "                x + step / scale;\n",
              "\n",
              "\n",
              "            const valueNext =\n",
              "                equation(\n",
              "                    xNext,\n",
              "                    y\n",
              "                );\n",
              "\n",
              "\n",
              "            if (\n",
              "                value === 0 ||\n",
              "                value * valueNext < 0\n",
              "            ) {\n",
              "\n",
              "                ctx.fillRect(\n",
              "                    px,\n",
              "                    py,\n",
              "                    2,\n",
              "                    2\n",
              "                );\n",
              "\n",
              "            }\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Graph title\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"#102a56\";\n",
              "\n",
              "    ctx.font =\n",
              "        \"bold 16px Arial\";\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "        classification,\n",
              "        20,\n",
              "        30\n",
              "    );\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Axis labels\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    ctx.font =\n",
              "        \"14px Arial\";\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "        \"x\",\n",
              "        width - 20,\n",
              "        originY - 8\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "        \"y\",\n",
              "        originX + 8,\n",
              "        18\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
