              "\n",
              "        <!-- GRAPH -->\n",
              "        <section class=\"glass-card graph-card\">\n",
              "\n",
              "            <div class=\"section-heading\">\n",
              "                <span>05</span>\n",
              "                <h3>Conic Visualization</h3>\n",
              "            </div>\n",
              "\n",
              "            <div class=\"graph-container\">\n",
              "\n",
              "                <canvas id=\"conicCanvas\">\n",
              "                </canvas>\n",
              "\n",
              "            </div>\n",
              "\n",
              "        </section>\n",
              "\n",
              "\n",
              "        <!-- MATHEMATICAL PROCESS -->\n",
              "        <section class=\"glass-card\">\n",
              "\n",
              "            <div class=\"section-heading\">\n",
              "                <span>06</span>\n",
              "                <h3>Mathematical Process</h3>\n",
              "            </div>\n",
              "\n",
              "\n",
              "            <div class=\"process-grid\">\n",
              "\n",
              "\n",
              "                <div class=\"process-card\">\n",
              "\n",
              "                    <span>01</span>\n",
              "\n",
              "                    <h4>Quadratic Form</h4>\n",
              "\n",
              "                    <p>\n",
              "                        Construct the symmetric\n",
              "                        quadratic matrix A.\n",
              "                    </p>\n",
              "\n",
              "                </div>\n",
              "\n",
              "\n",
              "                <div class=\"process-card\">\n",
              "\n",
              "                    <span>02</span>\n",
              "\n",
              "                    <h4>Eigenvalues</h4>\n",
              "\n",
              "                    <p>\n",
              "                        Find eigenvalues and\n",
              "                        eigenvectors of A.\n",
              "                    </p>\n",
              "\n",
              "                </div>\n",
              "\n",
              "\n",
              "                <div class=\"process-card\">\n",
              "\n",
              "                    <span>03</span>\n",
              "\n",
              "                    <h4>Transformation</h4>\n",
              "\n",
              "                    <p>\n",
              "                        Apply an orthogonal\n",
              "                        coordinate transformation.\n",
              "                    </p>\n",
              "\n",
              "                </div>\n",
              "\n",
              "\n",
              "                <div class=\"process-card\">\n",
              "\n",
              "                    <span>04</span>\n",
              "\n",
              "                    <h4>Classification</h4>\n",
              "\n",
              "                    <p>\n",
              "                        Identify the type of\n",
              "                        conic section.\n",
              "                    </p>\n",
              "\n",
              "                </div>\n",
              "\n",
              "\n",
              "                <div class=\"process-card\">\n",
              "\n",
              "                    <span>05</span>\n",
              "\n",
              "                    <h4>Geometry</h4>\n",
              "\n",
              "                    <p>\n",
              "                        Calculate center,\n",
              "                        axes and rotation.\n",
              "                    </p>\n",
              "\n",
              "                </div>\n",
              "\n",
              "\n",
              "                <div class=\"process-card\">\n",
              "\n",
              "                    <span>06</span>\n",
              "\n",
              "                    <h4>Visualization</h4>\n",
              "\n",
              "                    <p>\n",
              "                        Plot the conic on the\n",
              "                        coordinate plane.\n",
              "                    </p>\n",
              "\n",
              "                </div>\n",
              "\n",
              "\n",
              "            </div>\n",
              "\n",
              "        </section>\n",
              "\n",
              "\n",
              "    </main>\n",
              "\n",
              "\n",
              "    <!-- FOOTER -->\n",
              "    <footer>\n",
              "\n",
              "        <strong>∞ INFINOVA</strong>\n",
              "\n",
              "        <p>\n",
              "            Conic Section Identifier • D7\n",
              "        </p>\n",
              "\n",
              "        <small>\n",
              "            B.Tech Mathematics Mini Project\n",
              "        </small>\n",
              "\n",
              "    </footer>\n",
              "\n",
              "</div>\n",
              "\n"
            ]
          },
