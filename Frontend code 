              "            document.getElementById(\"input-h\").value\n",
              "        ),\n",
              "\n",
              "        b: parseFloat(\n",
              "            document.getElementById(\"input-b\").value\n",
              "        ),\n",
              "\n",
              "        g: parseFloat(\n",
              "            document.getElementById(\"input-g\").value\n",
              "        ),\n",
              "\n",
              "        f: parseFloat(\n",
              "            document.getElementById(\"input-f\").value\n",
