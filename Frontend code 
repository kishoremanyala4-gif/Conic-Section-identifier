              "\n",
              "    document.getElementById(\n",
              "        \"classification\"\n",
              "    ).innerText =\n",
              "        classification;\n",
              "\n",
              "\n",
              "    // ---------------------------------------------\n",
              "    // Canonical form\n",
              "    // ---------------------------------------------\n",
              "\n",
              "    generateCanonicalForm(\n",
              "        classification,\n",
              "        lambda1,\n",
              "        lambda2,\n",
              "        a,\n",
