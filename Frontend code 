              "\n",
              "\n",
              "<script>\n",
              "\n",
              "\n",
              "// =========================================================\n",
              "// GET INPUTS\n",
              "// =========================================================\n",
              "\n",
              "function getFrontendInputs() {\n",
              "\n",
              "    return {\n",
              "\n",
              "        a: parseFloat(\n",
              "            document.getElementById(\"input-a\").value\n",
              "        ),\n",
              "\n",
